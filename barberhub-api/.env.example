APP_NAME=BarberHub
APP_ENV=local
APP_KEY=
# APP_PREVIOUS_KEYS=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Costa_Rica

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=pgsql
# DB_URL=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=barberhub
DB_USERNAME=barberhub_app
DB_PASSWORD=
DB_ADMIN_USERNAME=barberhub_owner
DB_ADMIN_PASSWORD=
DB_SSLMODE=prefer
# DB_CHARSET=utf8

# Temporary: the queue driver is still pending (RD-11). Replace it once it is decided.
QUEUE_CONNECTION=sync
