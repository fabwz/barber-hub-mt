APP_NAME=BarberHub
APP_ENV=local
APP_KEY=
# APP_PREVIOUS_KEYS=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Costa_Rica

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=pgsql
# DB_URL=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=barberhub
DB_USERNAME=barberhub_app
DB_PASSWORD=
DB_ADMIN_USERNAME=barberhub_owner
DB_ADMIN_PASSWORD=
DB_SSLMODE=prefer
# DB_CHARSET=utf8

# Provisional: the queue driver is still pending (RD-11, PD-03). The jobs of the waitlist and of the expiry of temporary reservations run on the
# tables of the database until it is decided; start a worker with `php artisan queue:work`. The tests use sync (phpunit.xml).
QUEUE_CONNECTION=database

# Live agenda (RF-36): Reverb is the WebSocket server (ADR 0012). Each process is started apart:
#   php artisan reverb:start                          the WebSocket server
#   php artisan queue:work --queue=realtime --sleep=1  the worker that publishes the live events, alone in its queue
#   php artisan queue:work --queue=default            the worker of the notices, the reminders and the waitlist
# "null" publishes nothing (the tests). Generate the three values of the application with random strings; never write real ones here.
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
# Where the API publishes (the server) and how the browser reaches it.
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
# Where the server listens.
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
# Origins of the web client that may open a socket, separated by commas ("*" accepts any, for development only).
REVERB_ALLOWED_ORIGINS=http://localhost:5173

# Cache store of the application (framework default: database). Use "redis" in several servers.
# CACHE_STORE=database

# Mail of the notices to the customer: confirmation, offer, cancellation, reschedule and reminders (RF-33, RF-34).
# "log" writes the message to the log instead of sending it (development); "array" keeps it in memory (tests, phpunit.xml);
# "resend" sends it through Resend (deployment), which needs RESEND_API_KEY. Never write a real key here: it lives only in the real .env.
# The tasks that send run in the queue worker (`php artisan queue:work`), so a worker must be running for any mail to go out.
MAIL_MAILER=log
RESEND_API_KEY=
# Test sender of Resend, for development: it needs no verified domain. Check in the Resend documentation which addresses it may write to;
# the deployment needs its own sender from a domain verified in Resend.
MAIL_FROM_ADDRESS=onboarding@resend.dev
MAIL_FROM_NAME="BarberHub"
# Emails per second the workers may send; Resend limits the requests per second of an account (check its plan).
# NOTICES_MAIL_PER_SECOND=2
# Address of the web client: the link to reset a password (RF-41) opens a screen of it. No slash at the end.
WEB_URL=http://localhost:5173

# Gateway used for a new charge when the barbershop has not chosen one: onvo or paypal (PA-02).
PAYMENTS_DEFAULT_GATEWAY=onvo

# ONVO Pay (RF-20). Only a test key (onvo_test_secret_key_...) is accepted; a live key is refused.
ONVO_SECRET_KEY=
# Defaults to https://api.onvopay.com/v1 when empty.
ONVO_BASE_URL=
# Where the customer returns after a 3DS check.
ONVO_RETURN_URL=
# Number for SINPE Móvil transfers; defaults to +506 70196686 when empty.
ONVO_SINPE_DESTINATION=
# Signing secret (whsec_...) of the webhook endpoint registered in the ONVO Pay dashboard. Without it, notices are refused (503).
ONVO_WEBHOOK_SECRET=

# PayPal (RF-20), Orders API v2, sandbox only: the live API is refused.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Defaults to https://api-m.sandbox.paypal.com when empty.
PAYPAL_BASE_URL=
# Where PayPal sends the customer after approving or cancelling.
PAYPAL_RETURN_URL=
PAYPAL_CANCEL_URL=
# Colones per dollar used to convert the amount (PayPal charges in USD); defaults to 500 when empty.
PAYPAL_CRC_PER_USD=
# Identifier of the webhook registered in the PayPal developer dashboard. Without it, notices are refused (503).
PAYPAL_WEBHOOK_ID=

# Language provider of the reservation by phrase (RF-37): Google Gemini, generateContent. Without the key the extractor is "unavailable" and never calls Google.
GEMINI_API_KEY=
# Required: name of the model, copied from the Google AI Studio documentation (a Flash or Flash-Lite model with a free tier). It is not written in the code.
GEMINI_MODEL=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# Circuit breaker of the provider (IA-05, RNF-11): after this many consecutive failures of availability inside the window (seconds), the provider is not called for the open time (seconds) and one probe call decides whether it closes. Empty uses the default (3, 60, 60).
AI_CIRCUIT_FAILURES=3
AI_CIRCUIT_WINDOW_SECONDS=60
AI_CIRCUIT_OPEN_SECONDS=60
# Cache store that keeps the state of the circuit, shared between processes. It is NOT the default store on purpose: the default one is the database, and a request runs inside a transaction that is rolled back when it fails, which would erase the failures. Use "file" in one server or "redis" in several.
AI_CIRCUIT_CACHE_STORE=file

# Monitoring panel at /monitoreo (RNF-15, ADR 0013). One switch turns on both the recording of the requests and the panel; it is off by default and in the tests.
MONITOR_ENABLED=false
# The panel uses HTTP Basic authentication and stays closed (404) until BOTH values are set. Over HTTPS only. The user is any name; the password is stored as a bcrypt hash, never in clear:
#   php -r "echo password_hash('the-password-you-choose', PASSWORD_BCRYPT), PHP_EOL;"
# In a .env file escape each dollar sign of the hash with a backslash, or wrap the hash in single quotes. Never write a real value here.
MONITOR_USER=
MONITOR_PASSWORD_HASH=
