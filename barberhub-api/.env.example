APP_NAME=BarberHub
APP_ENV=local
APP_KEY=
# APP_PREVIOUS_KEYS=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Costa_Rica

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=pgsql
# DB_URL=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=barberhub
DB_USERNAME=barberhub_app
DB_PASSWORD=
DB_ADMIN_USERNAME=barberhub_owner
DB_ADMIN_PASSWORD=
DB_SSLMODE=prefer
# DB_CHARSET=utf8

# Temporary: the queue driver is still pending (RD-11). Replace it once it is decided.
QUEUE_CONNECTION=sync

# Gateway used for a new charge when the barbershop has not chosen one: onvo or paypal (PA-02).
PAYMENTS_DEFAULT_GATEWAY=onvo

# ONVO Pay (RF-20). Only a test key (onvo_test_secret_key_...) is accepted; a live key is refused.
ONVO_SECRET_KEY=
# Defaults to https://api.onvopay.com/v1 when empty.
ONVO_BASE_URL=
# Where the customer returns after a 3DS check.
ONVO_RETURN_URL=
# Number for SINPE Móvil transfers; defaults to +506 70196686 when empty.
ONVO_SINPE_DESTINATION=
# Signing secret (whsec_...) of the webhook endpoint registered in the ONVO Pay dashboard. Without it, notices are refused (503).
ONVO_WEBHOOK_SECRET=

# PayPal (RF-20), Orders API v2, sandbox only: the live API is refused.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Defaults to https://api-m.sandbox.paypal.com when empty.
PAYPAL_BASE_URL=
# Where PayPal sends the customer after approving or cancelling.
PAYPAL_RETURN_URL=
PAYPAL_CANCEL_URL=
# Colones per dollar used to convert the amount (PayPal charges in USD); defaults to 500 when empty.
PAYPAL_CRC_PER_USD=
# Identifier of the webhook registered in the PayPal developer dashboard. Without it, notices are refused (503).
PAYPAL_WEBHOOK_ID=

# Language provider of the reservation by phrase (RF-37): Google Gemini, generateContent. Without the key the extractor is "unavailable" and never calls Google.
GEMINI_API_KEY=
# Required: name of the model, copied from the Google AI Studio documentation (a Flash or Flash-Lite model with a free tier). It is not written in the code.
GEMINI_MODEL=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# Circuit breaker of the provider (IA-05, RNF-11): after this many consecutive failures of availability inside the window (seconds), the provider is not called for the open time (seconds) and one probe call decides whether it closes. Empty uses the default (3, 60, 60).
AI_CIRCUIT_FAILURES=3
AI_CIRCUIT_WINDOW_SECONDS=60
AI_CIRCUIT_OPEN_SECONDS=60
# Cache store that keeps the state of the circuit, shared between processes. It is NOT the default store on purpose: the default one is the database, and a request runs inside a transaction that is rolled back when it fails, which would erase the failures. Use "file" in one server or "redis" in several.
AI_CIRCUIT_CACHE_STORE=file
