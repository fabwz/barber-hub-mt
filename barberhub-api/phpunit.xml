<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Architecture">
            <directory>tests/Architecture</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
            <directory>src</directory>
        </include>
    </source>
    <php>
        <!-- The suite is near the 128M default of the PHP CLI: without this a new test can make `artisan test` run out of memory. -->
        <ini name="memory_limit" value="512M"/>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="APP_URL" value="http://localhost"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_DATABASE" value="barberhub_testing" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <!-- The tests never see a real key or model of the language provider. -->
        <env name="GEMINI_API_KEY" value="" force="true"/>
        <env name="GEMINI_MODEL" value="" force="true"/>
        <env name="GEMINI_BASE_URL" value="" force="true"/>
        <!-- The circuit of the provider keeps its state in memory in the tests, never in storage/. -->
        <env name="AI_CIRCUIT_CACHE_STORE" value="array" force="true"/>
        <!-- Only for tests: the real queue driver is still pending (RD-11). -->
        <env name="QUEUE_CONNECTION" value="sync"/>
    </php>
</phpunit>
