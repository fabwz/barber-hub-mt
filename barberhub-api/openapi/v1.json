{
    "openapi": "3.1.0",
    "info": {
        "title": "BarberHub API",
        "version": "1.0.0",
        "description": "API de BarberHub: reservas y cobro para barber\u00edas."
    },
    "servers": [
        {
            "url": "/api/v1"
        }
    ],
    "tags": [
        {
            "name": "General"
        },
        {
            "name": "Cuentas",
            "description": "Registro de cuentas de personas que usan BarberHub."
        },
        {
            "name": "Sesiones",
            "description": "Ingreso con correo y contrase\u00f1a y cierre de sesi\u00f3n mediante tokens de acceso."
        },
        {
            "name": "Barber\u00edas",
            "description": "Alta de barber\u00edas y de su due\u00f1o."
        },
        {
            "name": "Enlaces p\u00fablicos",
            "description": "Consulta de una barber\u00eda por su enlace, sin iniciar sesi\u00f3n."
        },
        {
            "name": "Servicios p\u00fablicos",
            "description": "Consulta de los servicios de una barber\u00eda, sin iniciar sesi\u00f3n."
        },
        {
            "name": "Servicios de la barber\u00eda",
            "description": "Administraci\u00f3n de los servicios por el due\u00f1o de la barber\u00eda."
        }
    ],
    "security": [
        {
            "http": []
        }
    ],
    "paths": {
        "/barberias": {
            "post": {
                "operationId": "catalog.barbershops.store",
                "description": "Crea una barber\u00eda con nombre, ciudad y tel\u00e9fono de contacto, sin servicios ni horario, y deja a la persona autenticada como su due\u00f1a activa (`rol: dueno`). Una persona puede registrar varias barber\u00edas. La respuesta trae el `enlace` p\u00fablico, derivado del nombre (por ejemplo `pura-navaja`, o `pura-navaja-2` si ya existe), que se genera una sola vez y no cambia. Responde 401 `no-autenticado` sin token y 422 `datos-invalidos` si falta un dato o supera su largo m\u00e1ximo (`errores` lista cada campo).",
                "summary": "Registrar una barber\u00eda",
                "tags": [
                    "Barber\u00edas"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/RegistroDeBarberia"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "`Barberia`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/Barberia"
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/Unauthenticated"
                    },
                    "422": {
                        "$ref": "#/components/responses/InvalidData"
                    }
                }
            }
        },
        "/cuentas": {
            "post": {
                "operationId": "identity.users.store",
                "description": "Crea una cuenta con nombre, correo, tel\u00e9fono y contrase\u00f1a, y guarda la fecha de cada aceptaci\u00f3n (t\u00e9rminos y privacidad), que se exigen por separado. No crea ninguna membres\u00eda: el rol de cliente nace al primer uso en una barber\u00eda. Responde 422 `datos-invalidos` si falta un dato, una aceptaci\u00f3n o un requisito de la contrase\u00f1a (`errores.contrasena` lista todos los que faltan), o si el correo ya tiene una cuenta.",
                "summary": "Registrar una cuenta",
                "tags": [
                    "Cuentas"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/RegistroDeCuenta"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "`Cuenta`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/Cuenta"
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    },
                    "422": {
                        "$ref": "#/components/responses/InvalidData"
                    }
                },
                "security": []
            }
        },
        "/enlaces/{enlace}": {
            "get": {
                "operationId": "catalog.barbershops.show-by-link",
                "description": "Devuelve el `id` de la barber\u00eda, que es el que usan las dem\u00e1s rutas en `{barberia}`, y sus datos p\u00fablicos. El enlace son min\u00fasculas, d\u00edgitos y guiones. Responde 404 `no-encontrado` con el mensaje \"Esta barber\u00eda no existe\" si ninguna barber\u00eda tiene ese enlace o si el enlace no tiene ese formato.",
                "summary": "Consultar una barber\u00eda por su enlace",
                "tags": [
                    "Enlaces p\u00fablicos"
                ],
                "parameters": [
                    {
                        "name": "enlace",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "`BarberiaPublica`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/BarberiaPublica"
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    },
                    "404": {
                        "$ref": "#/components/responses/NotFound"
                    }
                },
                "security": []
            }
        },
        "/": {
            "get": {
                "operationId": "index",
                "summary": "Identificar la API y su versi\u00f3n",
                "tags": [
                    "General"
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "nombre": {
                                            "type": "string"
                                        },
                                        "version": {
                                            "type": "string",
                                            "const": "v1"
                                        }
                                    },
                                    "required": [
                                        "nombre",
                                        "version"
                                    ]
                                }
                            }
                        }
                    }
                },
                "security": []
            }
        },
        "/barberias/{barberia}/administracion/servicios": {
            "get": {
                "operationId": "catalog.services.index",
                "description": "Trae todos los servicios, activos e inactivos, ordenados por nombre. Cada uno trae su `precio` con el IVA de 13 % incluido, desglosado en `base` e `iva`. Solo el due\u00f1o: un colaborador recibe 403 `prohibido` y quien no tiene rol en la barber\u00eda, 404 `no-encontrado`.",
                "summary": "Listar los servicios de la barber\u00eda",
                "tags": [
                    "Servicios de la barber\u00eda"
                ],
                "parameters": [
                    {
                        "name": "barberia",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Array of `Servicio`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/Servicio"
                                            }
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/Unauthenticated"
                    },
                    "404": {
                        "$ref": "#/components/responses/NotFound"
                    }
                }
            },
            "post": {
                "operationId": "catalog.services.store",
                "description": "Crea un servicio activo con nombre, duraci\u00f3n (10 a 180 minutos, de 5 en 5) y precio en colones enteros mayores que cero, con el IVA incluido. Una duraci\u00f3n o un precio fuera de rango responde 422 `datos-invalidos` y `errores` indica el campo. Solo el due\u00f1o.",
                "summary": "Crear un servicio",
                "tags": [
                    "Servicios de la barber\u00eda"
                ],
                "parameters": [
                    {
                        "name": "barberia",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/CrearServicio"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "`Servicio`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/Servicio"
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/Unauthenticated"
                    },
                    "422": {
                        "$ref": "#/components/responses/InvalidData"
                    },
                    "404": {
                        "$ref": "#/components/responses/NotFound"
                    }
                }
            }
        },
        "/barberias/{barberia}/administracion/servicios/{servicio}": {
            "patch": {
                "operationId": "catalog.services.update",
                "description": "Cambia solo los campos que vienen. `activo: false` inactiva el servicio, que deja de ofrecerse pero se conserva para el historial, y `activo: true` lo reactiva; un servicio nunca se borra. Las reservas ya hechas conservan el precio y la duraci\u00f3n con que se hicieron (SV-03). Responde 404 `no-encontrado` si el servicio no existe en la barber\u00eda. Solo el due\u00f1o.",
                "summary": "Editar, inactivar o reactivar un servicio",
                "tags": [
                    "Servicios de la barber\u00eda"
                ],
                "parameters": [
                    {
                        "name": "barberia",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    },
                    {
                        "name": "servicio",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    }
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/ActualizarServicio"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "`Servicio`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/Servicio"
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/Unauthenticated"
                    },
                    "422": {
                        "$ref": "#/components/responses/InvalidData"
                    },
                    "404": {
                        "$ref": "#/components/responses/NotFound"
                    }
                }
            }
        },
        "/barberias/{barberia}/servicios": {
            "get": {
                "operationId": "catalog.services.public.index",
                "description": "Trae solo los servicios activos, ordenados por nombre. El `precio` incluye el IVA de 13 % y viene desglosado en `base` e `iva`, de modo que `base` m\u00e1s `iva` es el `precio`. Una barber\u00eda sin servicios activos, o que no existe, devuelve una lista vac\u00eda.",
                "summary": "Consultar los servicios de una barber\u00eda",
                "tags": [
                    "Servicios p\u00fablicos"
                ],
                "parameters": [
                    {
                        "name": "barberia",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Array of `ServicioPublico`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/ServicioPublico"
                                            }
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    },
                    "404": {
                        "$ref": "#/components/responses/NotFound"
                    }
                },
                "security": []
            }
        },
        "/tokens": {
            "post": {
                "operationId": "identity.tokens.store",
                "description": "Devuelve un token Bearer, que se env\u00eda en el encabezado `Authorization`. El token identifica a la persona, no su rol: el rol se verifica en cada petici\u00f3n seg\u00fan la barber\u00eda. Responde 401 `credenciales-invalidas` si el correo no existe, la contrase\u00f1a no coincide o la cuenta est\u00e1 desactivada, sin indicar cu\u00e1l dato fall\u00f3. Tras 5 intentos fallidos seguidos desde la misma direcci\u00f3n y con el mismo correo, responde 429 `demasiadas-solicitudes` durante 15 minutos, contados desde el quinto fallo, con el encabezado `Retry-After` en segundos y los minutos para reintentar en el detalle; en ese lapso rechaza incluso la contrase\u00f1a correcta.",
                "summary": "Ingresar con correo y contrase\u00f1a",
                "tags": [
                    "Sesiones"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/Credenciales"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "`TokenDeAcceso`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/TokenDeAcceso"
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    },
                    "422": {
                        "$ref": "#/components/responses/InvalidData"
                    }
                },
                "security": []
            },
            "delete": {
                "operationId": "identity.tokens.destroy-all",
                "description": "Revoca todos los tokens de la persona, incluido el de la petici\u00f3n.",
                "summary": "Cerrar la sesi\u00f3n en todos los dispositivos",
                "tags": [
                    "Sesiones"
                ],
                "responses": {
                    "204": {
                        "description": "No content"
                    },
                    "401": {
                        "$ref": "#/components/responses/Unauthenticated"
                    }
                }
            }
        },
        "/tokens/actual": {
            "delete": {
                "operationId": "identity.tokens.destroy-current",
                "description": "Revoca el token con el que se hace la petici\u00f3n. Desde ese momento el token responde 401 `no-autenticado`.",
                "summary": "Cerrar la sesi\u00f3n en este dispositivo",
                "tags": [
                    "Sesiones"
                ],
                "responses": {
                    "204": {
                        "description": "No content"
                    },
                    "401": {
                        "$ref": "#/components/responses/Unauthenticated"
                    }
                }
            }
        }
    },
    "components": {
        "securitySchemes": {
            "http": {
                "type": "http",
                "scheme": "bearer"
            }
        },
        "schemas": {
            "ActualizarServicio": {
                "type": "object",
                "properties": {
                    "nombre": {
                        "type": "string",
                        "maxLength": 120
                    },
                    "duracion_minutos": {
                        "type": "integer",
                        "description": "Entre 10 y 180 minutos, de 5 en 5.",
                        "minimum": 10,
                        "maximum": 180
                    },
                    "precio": {
                        "type": "integer",
                        "description": "Colones enteros con el IVA de 13 % incluido, mayores que cero.",
                        "minimum": 1
                    },
                    "activo": {
                        "type": "boolean",
                        "description": "`false` inactiva el servicio y `true` lo vuelve a activar; un servicio nunca se borra."
                    }
                },
                "title": "ActualizarServicio"
            },
            "Barberia": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "nombre": {
                        "type": "string"
                    },
                    "ciudad": {
                        "type": "string"
                    },
                    "telefono": {
                        "type": "string"
                    },
                    "enlace": {
                        "type": "string"
                    },
                    "rol": {
                        "type": "string",
                        "const": "dueno"
                    }
                },
                "required": [
                    "id",
                    "nombre",
                    "ciudad",
                    "telefono",
                    "enlace",
                    "rol"
                ],
                "title": "Barberia"
            },
            "BarberiaPublica": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "nombre": {
                        "type": "string"
                    },
                    "ciudad": {
                        "type": "string"
                    },
                    "telefono": {
                        "type": "string"
                    }
                },
                "required": [
                    "id",
                    "nombre",
                    "ciudad",
                    "telefono"
                ],
                "title": "BarberiaPublica"
            },
            "CrearServicio": {
                "type": "object",
                "properties": {
                    "nombre": {
                        "type": "string",
                        "maxLength": 120
                    },
                    "duracion_minutos": {
                        "type": "integer",
                        "description": "Entre 10 y 180 minutos, de 5 en 5.",
                        "minimum": 10,
                        "maximum": 180
                    },
                    "precio": {
                        "type": "integer",
                        "description": "Colones enteros con el IVA de 13 % incluido, mayores que cero.",
                        "minimum": 1
                    }
                },
                "required": [
                    "nombre",
                    "duracion_minutos",
                    "precio"
                ],
                "title": "CrearServicio"
            },
            "Credenciales": {
                "type": "object",
                "properties": {
                    "correo": {
                        "type": "string",
                        "format": "email",
                        "maxLength": 255
                    },
                    "contrasena": {
                        "type": "string"
                    },
                    "dispositivo": {
                        "type": "string",
                        "maxLength": 100
                    }
                },
                "required": [
                    "correo",
                    "contrasena",
                    "dispositivo"
                ],
                "title": "Credenciales"
            },
            "Cuenta": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "nombre": {
                        "type": "string"
                    },
                    "correo": {
                        "type": "string"
                    },
                    "telefono": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "acepta_terminos": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "acepta_privacidad": {
                        "type": [
                            "string",
                            "null"
                        ]
                    }
                },
                "required": [
                    "id",
                    "nombre",
                    "correo",
                    "telefono",
                    "acepta_terminos",
                    "acepta_privacidad"
                ],
                "title": "Cuenta"
            },
            "RegistroDeBarberia": {
                "type": "object",
                "properties": {
                    "nombre": {
                        "type": "string",
                        "maxLength": 120
                    },
                    "ciudad": {
                        "type": "string",
                        "maxLength": 80
                    },
                    "telefono": {
                        "type": "string",
                        "maxLength": 30
                    }
                },
                "required": [
                    "nombre",
                    "ciudad",
                    "telefono"
                ],
                "title": "RegistroDeBarberia"
            },
            "RegistroDeCuenta": {
                "type": "object",
                "properties": {
                    "nombre": {
                        "type": "string",
                        "maxLength": 120
                    },
                    "correo": {
                        "type": "string",
                        "format": "email",
                        "maxLength": 255
                    },
                    "telefono": {
                        "type": "string",
                        "maxLength": 30
                    },
                    "contrasena": {
                        "type": "string"
                    },
                    "acepta_terminos": {
                        "enum": [
                            "yes",
                            "on",
                            "1",
                            1,
                            "true",
                            true
                        ]
                    },
                    "acepta_privacidad": {
                        "enum": [
                            "yes",
                            "on",
                            "1",
                            1,
                            "true",
                            true
                        ]
                    }
                },
                "required": [
                    "nombre",
                    "correo",
                    "telefono",
                    "contrasena",
                    "acepta_terminos",
                    "acepta_privacidad"
                ],
                "title": "RegistroDeCuenta"
            },
            "Servicio": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "nombre": {
                        "type": "string"
                    },
                    "duracion_minutos": {
                        "type": "integer"
                    },
                    "precio": {
                        "type": "integer",
                        "description": "Colones con el IVA incluido; es igual a `base` m\u00e1s `iva`."
                    },
                    "base": {
                        "type": "integer"
                    },
                    "iva": {
                        "type": "integer"
                    },
                    "activo": {
                        "type": "boolean"
                    }
                },
                "required": [
                    "id",
                    "nombre",
                    "duracion_minutos",
                    "precio",
                    "base",
                    "iva",
                    "activo"
                ],
                "title": "Servicio"
            },
            "ServicioPublico": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "nombre": {
                        "type": "string"
                    },
                    "duracion_minutos": {
                        "type": "integer"
                    },
                    "precio": {
                        "type": "integer",
                        "description": "Colones con el IVA incluido; es igual a `base` m\u00e1s `iva`."
                    },
                    "base": {
                        "type": "integer"
                    },
                    "iva": {
                        "type": "integer"
                    }
                },
                "required": [
                    "id",
                    "nombre",
                    "duracion_minutos",
                    "precio",
                    "base",
                    "iva"
                ],
                "title": "ServicioPublico"
            },
            "TokenDeAcceso": {
                "type": "object",
                "properties": {
                    "token": {
                        "type": "string"
                    },
                    "tipo": {
                        "type": "string",
                        "const": "Bearer"
                    }
                },
                "required": [
                    "token",
                    "tipo"
                ],
                "title": "TokenDeAcceso"
            }
        },
        "responses": {
            "Unauthenticated": {
                "description": "No autenticado",
                "content": {
                    "application/problem+json": {
                        "schema": {
