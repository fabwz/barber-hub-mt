{
    "openapi": "3.1.0",
    "info": {
        "title": "BarberHub API",
        "version": "1.0.0",
        "description": "API de BarberHub: reservas y cobro para barber\u00edas."
    },
    "servers": [
        {
            "url": "/api/v1"
        }
    ],
    "tags": [
        {
            "name": "General"
        },
        {
            "name": "Cuentas",
            "description": "Registro de cuentas de personas que usan BarberHub."
        }
    ],
    "paths": {
        "/cuentas": {
            "post": {
                "operationId": "identity.users.store",
                "description": "Crea una cuenta con nombre, correo, tel\u00e9fono y contrase\u00f1a, y guarda la fecha de cada aceptaci\u00f3n (t\u00e9rminos y privacidad), que se exigen por separado. No crea ninguna membres\u00eda: el rol de cliente nace al primer uso en una barber\u00eda. Responde 422 `datos-invalidos` si falta un dato, una aceptaci\u00f3n o un requisito de la contrase\u00f1a (`errores.contrasena` lista todos los que faltan), o si el correo ya tiene una cuenta.",
                "summary": "Registrar una cuenta",
                "tags": [
                    "Cuentas"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/RegistroDeCuenta"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "`Cuenta`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/Cuenta"
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    },
                    "422": {
                        "$ref": "#/components/responses/InvalidData"
                    }
                }
            }
        },
        "/": {
            "get": {
                "operationId": "index",
                "summary": "Identificar la API y su versi\u00f3n",
                "tags": [
                    "General"
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "nombre": {
                                            "type": "string"
                                        },
                                        "version": {
                                            "type": "string",
                                            "const": "v1"
                                        }
                                    },
                                    "required": [
                                        "nombre",
                                        "version"
                                    ]
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "Cuenta": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "nombre": {
                        "type": "string"
                    },
                    "correo": {
                        "type": "string"
                    },
                    "telefono": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "acepta_terminos": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "acepta_privacidad": {
                        "type": [
                            "string",
                            "null"
                        ]
                    }
                },
                "required": [
                    "id",
                    "nombre",
                    "correo",
                    "telefono",
                    "acepta_terminos",
                    "acepta_privacidad"
                ],
                "title": "Cuenta"
            },
            "RegistroDeCuenta": {
                "type": "object",
                "properties": {
                    "nombre": {
                        "type": "string",
                        "maxLength": 120
                    },
                    "correo": {
                        "type": "string",
                        "format": "email",
                        "maxLength": 255
                    },
                    "telefono": {
                        "type": "string",
                        "maxLength": 30
                    },
                    "contrasena": {
                        "type": "string"
                    },
                    "acepta_terminos": {
                        "enum": [
                            "yes",
                            "on",
                            "1",
                            1,
                            "true",
                            true
                        ]
                    },
                    "acepta_privacidad": {
                        "enum": [
                            "yes",
                            "on",
                            "1",
                            1,
                            "true",
                            true
                        ]
                    }
                },
                "required": [
                    "nombre",
                    "correo",
                    "telefono",
                    "contrasena",
                    "acepta_terminos",
                    "acepta_privacidad"
                ],
                "title": "RegistroDeCuenta"
            }
        },
        "responses": {
            "Unauthenticated": {
                "description": "No autenticado",
                "content": {
                    "application/problem+json": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "type": {
                                    "type": "string",
                                    "format": "uri"
                                },
                                "title": {
                                    "type": "string"
                                },
                                "status": {
                                    "type": "integer"
                                },
                                "detail": {
                                    "type": "string"
                                },
                                "instance": {
                                    "type": "string",
                                    "format": "uri"
                                }
                            },
                            "required": [
                                "type",
                                "title",
                                "status",
                                "detail",
                                "instance"
                            ]
                        }
                    }
                }
            },
            "NotFound": {
                "description": "Recurso no encontrado",
                "content": {
                    "application/problem+json": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "type": {
                                    "type": "string",
                                    "format": "uri"
                                },
                                "title": {
                                    "type": "string"
                                },
                                "status": {
                                    "type": "integer"
                                },
                                "detail": {
                                    "type": "string"
                                },
                                "instance": {
                                    "type": "string",
                                    "format": "uri"
                                }
                            },
                            "required": [
                                "type",
                                "title",
                                "status",
                                "detail",
                                "instance"
                            ]
                        }
                    }
                }
            },
            "Forbidden": {
                "description": "Acci\u00f3n no permitida",
                "content": {
                    "application/problem+json": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "type": {
                                    "type": "string",
                                    "format": "uri"
                                },
                                "title": {
                                    "type": "string"
                                },
                                "status": {
                                    "type": "integer"
                                },
                                "detail": {
                                    "type": "string"
                                },
                                "instance": {
                                    "type": "string",
                                    "format": "uri"
                                }
                            },
                            "required": [
                                "type",
                                "title",
                                "status",
                                "detail",
                                "instance"
                            ]
                        }
                    }
                }
            },
            "InvalidData": {
                "description": "Datos inv\u00e1lidos",
                "content": {
                    "application/problem+json": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "type": {
                                    "type": "string",
                                    "format": "uri"
                                },
                                "title": {
                                    "type": "string"
                                },
                                "status": {
                                    "type": "integer"
                                },
                                "detail": {
                                    "type": "string"
                                },
                                "instance": {
                                    "type": "string",
                                    "format": "uri"
                                },
                                "errores": {
                                    "type": "object",
                                    "additionalProperties": {
                                        "type": "array",
                                        "items": {
                                            "type": "string"
                                        }
                                    }
                                }
                            },
                            "required": [
                                "type",
                                "title",
                                "status",
                                "detail",
                                "instance"
                            ]
                        }
                    }
                }
            }
        }
    }
}