{
    "openapi": "3.1.0",
    "info": {
        "title": "BarberHub API",
        "version": "1.0.0",
        "description": "API de BarberHub: reservas y cobro para barber\u00edas."
    },
    "servers": [
        {
            "url": "/api/v1"
        }
    ],
    "tags": [
        {
            "name": "General"
        },
        {
            "name": "Cuentas",
            "description": "Registro de cuentas de personas que usan BarberHub."
        },
        {
            "name": "Sesiones",
            "description": "Ingreso con correo y contrase\u00f1a y cierre de sesi\u00f3n mediante tokens de acceso."
        }
    ],
    "security": [
        {
            "http": []
        }
    ],
    "paths": {
        "/cuentas": {
            "post": {
                "operationId": "identity.users.store",
                "description": "Crea una cuenta con nombre, correo, tel\u00e9fono y contrase\u00f1a, y guarda la fecha de cada aceptaci\u00f3n (t\u00e9rminos y privacidad), que se exigen por separado. No crea ninguna membres\u00eda: el rol de cliente nace al primer uso en una barber\u00eda. Responde 422 `datos-invalidos` si falta un dato, una aceptaci\u00f3n o un requisito de la contrase\u00f1a (`errores.contrasena` lista todos los que faltan), o si el correo ya tiene una cuenta.",
                "summary": "Registrar una cuenta",
                "tags": [
                    "Cuentas"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/RegistroDeCuenta"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "`Cuenta`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/Cuenta"
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    },
                    "422": {
                        "$ref": "#/components/responses/InvalidData"
                    }
                },
                "security": []
            }
        },
        "/": {
            "get": {
                "operationId": "index",
                "summary": "Identificar la API y su versi\u00f3n",
                "tags": [
                    "General"
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "nombre": {
                                            "type": "string"
                                        },
                                        "version": {
                                            "type": "string",
                                            "const": "v1"
                                        }
                                    },
                                    "required": [
                                        "nombre",
                                        "version"
                                    ]
                                }
                            }
                        }
                    }
                },
                "security": []
            }
        },
        "/tokens": {
            "post": {
                "operationId": "identity.tokens.store",
                "description": "Devuelve un token Bearer, que se env\u00eda en el encabezado `Authorization`. El token identifica a la persona, no su rol: el rol se verifica en cada petici\u00f3n seg\u00fan la barber\u00eda. Responde 401 `credenciales-invalidas` si el correo no existe, la contrase\u00f1a no coincide o la cuenta est\u00e1 desactivada, sin indicar cu\u00e1l dato fall\u00f3. Tras 5 intentos fallidos seguidos desde la misma direcci\u00f3n y con el mismo correo, responde 429 `demasiadas-solicitudes` durante 15 minutos, contados desde el quinto fallo, con el encabezado `Retry-After` en segundos y los minutos para reintentar en el detalle; en ese lapso rechaza incluso la contrase\u00f1a correcta.",
                "summary": "Ingresar con correo y contrase\u00f1a",
                "tags": [
                    "Sesiones"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/Credenciales"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "`TokenDeAcceso`",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/TokenDeAcceso"
                                        }
                                    },
                                    "required": [
                                        "data"
                                    ]
                                }
                            }
                        }
                    },
                    "422": {
                        "$ref": "#/components/responses/InvalidData"
                    }
                },
                "security": []
            },
            "delete": {
                "operationId": "identity.tokens.destroy-all",
                "description": "Revoca todos los tokens de la persona, incluido el de la petici\u00f3n.",
                "summary": "Cerrar la sesi\u00f3n en todos los dispositivos",
                "tags": [
                    "Sesiones"
                ],
                "responses": {
                    "204": {
                        "description": "No content"
                    },
                    "401": {
                        "$ref": "#/components/responses/Unauthenticated"
                    }
                }
            }
        },
        "/tokens/actual": {
            "delete": {
                "operationId": "identity.tokens.destroy-current",
                "description": "Revoca el token con el que se hace la petici\u00f3n. Desde ese momento el token responde 401 `no-autenticado`.",
                "summary": "Cerrar la sesi\u00f3n en este dispositivo",
                "tags": [
                    "Sesiones"
                ],
                "responses": {
                    "204": {
                        "description": "No content"
                    },
                    "401": {
                        "$ref": "#/components/responses/Unauthenticated"
                    }
                }
            }
        }
    },
    "components": {
        "securitySchemes": {
            "http": {
                "type": "http",
                "scheme": "bearer"
            }
        },
        "schemas": {
            "Credenciales": {
                "type": "object",
                "properties": {
                    "correo": {
                        "type": "string",
                        "format": "email",
                        "maxLength": 255
                    },
                    "contrasena": {
                        "type": "string"
                    },
                    "dispositivo": {
                        "type": "string",
                        "maxLength": 100
                    }
                },
                "required": [
                    "correo",
                    "contrasena",
                    "dispositivo"
                ],
                "title": "Credenciales"
            },
            "Cuenta": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "nombre": {
                        "type": "string"
                    },
                    "correo": {
                        "type": "string"
                    },
                    "telefono": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "acepta_terminos": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "acepta_privacidad": {
                        "type": [
                            "string",
                            "null"
                        ]
                    }
                },
                "required": [
                    "id",
                    "nombre",
                    "correo",
                    "telefono",
                    "acepta_terminos",
                    "acepta_privacidad"
                ],
                "title": "Cuenta"
            },
            "RegistroDeCuenta": {
                "type": "object",
                "properties": {
                    "nombre": {
                        "type": "string",
                        "maxLength": 120
                    },
                    "correo": {
                        "type": "string",
                        "format": "email",
                        "maxLength": 255
                    },
                    "telefono": {
                        "type": "string",
                        "maxLength": 30
                    },
                    "contrasena": {
                        "type": "string"
                    },
                    "acepta_terminos": {
                        "enum": [
                            "yes",
                            "on",
                            "1",
                            1,
                            "true",
                            true
                        ]
                    },
                    "acepta_privacidad": {
                        "enum": [
                            "yes",
                            "on",
                            "1",
                            1,
                            "true",
                            true
                        ]
                    }
                },
                "required": [
                    "nombre",
                    "correo",
                    "telefono",
                    "contrasena",
                    "acepta_terminos",
                    "acepta_privacidad"
                ],
                "title": "RegistroDeCuenta"
            },
            "TokenDeAcceso": {
                "type": "object",
                "properties": {
                    "token": {
                        "type": "string"
                    },
                    "tipo": {
                        "type": "string",
                        "const": "Bearer"
                    }
                },
                "required": [
                    "token",
                    "tipo"
                ],
                "title": "TokenDeAcceso"
            }
        },
        "responses": {
            "Unauthenticated": {
                "description": "No autenticado",
                "content": {
                    "application/problem+json": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "type": {
                                    "type": "string",
                                    "format": "uri"
                                },
                                "title": {
                                    "type": "string"
                                },
                                "status": {
                                    "type": "integer"
                                },
                                "detail": {
                                    "type": "string"
                                },
                                "instance": {
                                    "type": "string",
                                    "format": "uri"
                                }
                            },
                            "required": [
                                "type",
                                "title",
                                "status",
                                "detail",
                                "instance"
                            ]
                        }
                    }
                }
            },
            "NotFound": {
                "description": "Recurso no encontrado",
                "content": {
                    "application/problem+json": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "type": {
                                    "type": "string",
                                    "format": "uri"
                                },
                                "title": {
                                    "type": "string"
                                },
                                "status": {
                                    "type": "integer"
                                },
                                "detail": {
                                    "type": "string"
                                },
                                "instance": {
                                    "type": "string",
                                    "format": "uri"
                                }
                            },
                            "required": [
                                "type",
                                "title",
                                "status",
                                "detail",
                                "instance"
                            ]
                        }
                    }
                }
            },
            "Forbidden": {
                "description": "Acci\u00f3n no permitida",
                "content": {
                    "application/problem+json": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "type": {
                                    "type": "string",
                                    "format": "uri"
                                },
                                "title": {
                                    "type": "string"
                                },
                                "status": {
                                    "type": "integer"
                                },
                                "detail": {
                                    "type": "string"
                                },
                                "instance": {
                                    "type": "string",
                                    "format": "uri"
                                }
                            },
                            "required": [
                                "type",
                                "title",
                                "status",
                                "detail",
                                "instance"
                            ]
                        }
                    }
                }
            },
            "InvalidData": {
                "description": "Datos inv\u00e1lidos",
                "content": {
                    "application/problem+json": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "type": {
                                    "type": "string",
                                    "format": "uri"
                                },
                                "title": {
                                    "type": "string"
                                },
                                "status": {
                                    "type": "integer"
                                },
                                "detail": {
                                    "type": "string"
                                },
                                "instance": {
                                    "type": "string",
                                    "format": "uri"
                                },
                                "errores": {
                                    "type": "object",
                                    "additionalProperties": {
                                        "type": "array",
                                        "items": {
                                            "type": "string"
                                        }
                                    }
                                }
                            },
                            "required": [
                                "type",
                                "title",
                                "status",
                                "detail",
                                "instance"
                            ]
                        }
                    }
                }
            }
        }
    }
}