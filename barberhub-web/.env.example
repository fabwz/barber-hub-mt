VITE_API_URL=http://127.0.0.1:8000

# Llave pública de pruebas de ONVO Pay (onvo_test_publishable_key_…). Se deja vacía: se copia desde el panel de ONVO.
# El cliente solo acepta llaves que empiezan por onvo_test_. Nunca se pone aquí una llave real.
VITE_ONVO_PUBLISHABLE_KEY=
VITE_ONVO_API_URL=https://api.onvopay.com/v1

# Tiempo real (agenda en vivo, #113). Son los datos públicos de Reverb: REVERB_APP_KEY, REVERB_HOST, REVERB_PORT y REVERB_SCHEME de la API.
# Se dejan vacíos: con la llave o el servidor vacíos la agenda funciona igual, sin «En vivo». Nunca se pone aquí el secreto (REVERB_APP_SECRET).
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=
VITE_REVERB_PORT=
VITE_REVERB_SCHEME=
