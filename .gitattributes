# The deployment files run on Linux: they must keep LF line endings even when they are checked out on Windows.
*.sh text eol=lf
deploy/Caddyfile text eol=lf
deploy/*.Dockerfile text eol=lf
deploy/*.dockerignore text eol=lf
deploy/docker-compose.yml text eol=lf
deploy/postgres/** text eol=lf
deploy/php/** text eol=lf
deploy/.env.production.example text eol=lf
