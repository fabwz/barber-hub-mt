# Environment of PRODUCTION. Copy to deploy/.env on the server (never commit it) and fill it in.
#   cp .env.production.example .env && chmod 600 .env
# [SECRET] marks a value that must be unique, generated by you and kept only here and in your password manager.
# For passwords and keys use letters and digits only, so that no character needs escaping:  openssl rand -hex 24
# Compose and Laravel both read this file. A value with a dollar sign (the bcrypt hash) goes between SINGLE quotes.
# Mail, payments and the AI provider can stay empty at first: the features that need them answer as unavailable (docs/deployment.md).

# ---- Domain (read by docker-compose.yml and Caddy) -------------------------------------------------------------------------------
# The host name only, no scheme. From it come APP_URL, the origin Reverb accepts and the address of the wss socket.
DOMAIN=su-subdominio.duckdns.org

# ---- Application -----------------------------------------------------------------------------------------------------------------
APP_NAME=BarberHub
APP_ENV=production
# [SECRET] php artisan key:generate --show   (docs/deployment.md, step 5)
APP_KEY=
# [SECRET] only when rotating APP_KEY: the old keys, comma-separated.
# APP_PREVIOUS_KEYS=
APP_DEBUG=false
APP_TIMEZONE=America/Costa_Rica
APP_LOCALE=es
APP_FALLBACK_LOCALE=en
BCRYPT_ROUNDS=12
LOG_LEVEL=warning
# Proxies whose X-Forwarded-* headers are trusted: the Docker network of docker-compose.yml. Never "*".
TRUSTED_PROXIES=172.28.0.0/16

# ---- PostgreSQL (the roles are created once, when the volume is empty: postgres/init/01-roles.sh) -------------------------------
# [SECRET] superuser of the container: only for the backup and for maintenance.
POSTGRES_PASSWORD=
# Role of the application (barberhub_app): serves the requests, owns nothing.
DB_CONNECTION=pgsql
DB_USERNAME=barberhub_app
# [SECRET]
DB_PASSWORD=
# Role owner of the tables (barberhub_owner): runs the migrations (--database=pgsql_admin), serves nothing.
DB_ADMIN_USERNAME=barberhub_owner
# [SECRET]
DB_ADMIN_PASSWORD=
# The database talks to the application inside the private Docker network. With an external database use require or verify-full.
DB_SSLMODE=prefer

# ---- Queues and cache (provisional: RD-11 and PD-03 are still open) ---------------------------------------------------------------
QUEUE_CONNECTION=database
CACHE_STORE=database
AI_CIRCUIT_CACHE_STORE=file

# ---- Live agenda: Reverb (ADR 0012) -----------------------------------------------------------------------------------------------
# REVERB_HOST, REVERB_ALLOWED_ORIGINS (the host of DOMAIN, never "*") and the internal address the workers publish to are set by
# docker-compose.yml. The browser reaches the socket at wss://DOMAIN:443/app.
BROADCAST_CONNECTION=reverb
# [SECRET] random strings; generate each one apart.
REVERB_APP_ID=
# Public: it is also compiled into the web client.
REVERB_APP_KEY=
# [SECRET] never goes into the web client.
REVERB_APP_SECRET=
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# ---- Mail: Resend ------------------------------------------------------------------------------------------------------------------
MAIL_MAILER=resend
# [SECRET]
RESEND_API_KEY=
# An address of a domain verified in Resend. onboarding@resend.dev is only for development.
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="BarberHub"
# Emails per second the workers may send (check the plan of Resend). Optional.
# NOTICES_MAIL_PER_SECOND=2

# ---- Payments: TEST MODE ONLY (the system is not a commercial service, RL-05) ------------------------------------------------------
# Live keys and the live PayPal URL are refused by the adapters.
PAYMENTS_DEFAULT_GATEWAY=onvo
# [SECRET] onvo_test_secret_key_...
ONVO_SECRET_KEY=
# [SECRET] whsec_...  Without it the notices of ONVO are refused (503).
ONVO_WEBHOOK_SECRET=
ONVO_BASE_URL=https://api.onvopay.com/v1
# Where the customer returns after the 3DS check: the route of the web client, on your domain.
ONVO_RETURN_URL=https://su-subdominio.duckdns.org/pago/retorno
ONVO_SINPE_DESTINATION=
PAYPAL_CLIENT_ID=
# [SECRET]
PAYPAL_CLIENT_SECRET=
# Without it the notices of PayPal are refused (503).
PAYPAL_WEBHOOK_ID=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_RETURN_URL=https://su-subdominio.duckdns.org/pago/retorno
PAYPAL_CANCEL_URL=https://su-subdominio.duckdns.org/pago/retorno?cancelado=1
PAYPAL_CRC_PER_USD=500

# ---- AI provider of the reservation by phrase (RF-37) -----------------------------------------------------------------------------
# [SECRET] Without it the extractor is "unavailable" and never calls Google.
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
AI_CIRCUIT_FAILURES=3
AI_CIRCUIT_WINDOW_SECONDS=60
AI_CIRCUIT_OPEN_SECONDS=60

# ---- Monitoring panel at /monitoreo (RNF-15, ADR 0013) ----------------------------------------------------------------------------
MONITOR_ENABLED=true
MONITOR_USER=
# [SECRET] bcrypt hash BETWEEN SINGLE QUOTES (it contains dollar signs). Make it with:
#   docker compose run --rm --no-deps app php -r "echo password_hash('the-password-you-choose', PASSWORD_BCRYPT), PHP_EOL;"
MONITOR_PASSWORD_HASH=''

# ---- Uploaded files ----------------------------------------------------------------------------------------------------------------
# The "public" disk is storage/app/public, the volume "media" of docker-compose.yml.
FILESYSTEM_MEDIA=public

# ---- Web client: PUBLIC values compiled into the bundle (read by docker-compose.yml when building) -----------------------------------
# VITE_REVERB_APP_KEY, VITE_REVERB_HOST (DOMAIN), VITE_REVERB_PORT (443) and VITE_REVERB_SCHEME (https) come from the values above.
# Only a test key (onvo_test_publishable_key_...) is accepted by the client.
VITE_ONVO_PUBLISHABLE_KEY=
VITE_ONVO_API_URL=https://api.onvopay.com/v1
